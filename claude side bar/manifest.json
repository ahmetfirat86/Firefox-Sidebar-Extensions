{
  "manifest_version": 2,
  "name": "Claude & AI Sidebar",
  "version": "2.2",
  "description": "Claude odaklı, iframe engeline takılmayan çoklu AI kenar çubuğu.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "128": "icon.png"
  },
  "sidebar_action": {
    "default_title": "Claude AI Sidebar",
    "default_panel": "sidebar.html",
    "default_icon": "icon.png"
  }
}